{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ez-devportal.dev/schemas/guides-manifest-0.1.json",
  "title": "Guides bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "generator", "spec", "nav"],
  "properties": {
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "title": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "nav": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/navItem" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"
    },
    "navItem": {
      "oneOf": [
        { "$ref": "#/$defs/pageItem" },
        { "$ref": "#/$defs/groupItem" }
      ]
    },
    "pageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page"],
      "properties": {
        "page": { "$ref": "#/$defs/slug" },
        "label": { "type": "string", "maxLength": 80 },
        "hidden": { "type": "boolean", "default": false }
      }
    },
    "groupItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "items"],
      "properties": {
        "group": { "type": "string", "minLength": 1, "maxLength": 80 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/navItem" }
        }
      }
    }
  }
}
